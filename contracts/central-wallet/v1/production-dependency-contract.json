                    "env_enable_key": "CENTRAL_WALLET_ENABLED"
                },
                {
                    "path": "api_enabled",
                    "classification": "VERIFIED",
                    "required_type": "boolean",
                    "require_resolvable_when_env_enabled": true,
                    "env_enable_key": "CENTRAL_WALLET_API_ENABLED"
                },
                {
                    "path": "historical_wallet_visibility.enabled",
                    "classification": "VERIFIED",
                    "required_type": "boolean",
                    "require_resolvable_when_env_enabled": true,
                    "env_enable_key": "CENTRAL_WALLET_HISTORICAL_WALLET_VISIBILITY_ENABLED"
                }
            ]
        }
    ],
    "required_bindings": [
        {
            "class": "App\\CentralWallet\\Application\\WalletVisibilityService",
            "classification": "VERIFIED",
            "required_in_target": true
        },
        {
            "class": "App\\CentralWallet\\Application\\LedgerService",
            "classification": "VERIFIED",
