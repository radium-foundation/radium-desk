{
    "contract_version": "1.0.0",
    "project": "radium-desk",
    "role": "provider",
    "overlay_baseline_fixture_root": "contracts/central-wallet/v1/fixtures/overlay-baseline",
    "config_scenarios": [
        {
            "id": "provider_api_enabled",
            "env": {
                "CENTRAL_WALLET_ENABLED": "true",
                "CENTRAL_WALLET_API_ENABLED": "true",
                "CENTRAL_WALLET_HISTORICAL_WALLET_VISIBILITY_ENABLED": "true"
            },
            "required_paths": [
                {
                    "path": "enabled",
                    "classification": "VERIFIED",
