<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="APP_NAME" value="Radium Desk"/>
        <!-- Optional fallback only; prefer Git tags / release snapshot / CHANGELOG -->
        <env name="APP_VERSION" value="4.0.0"/>
        <env name="APP_TIMEZONE" value="Asia/Kolkata"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="WORKFORCE_ATTENDANCE_MANAGEMENT_RESTRICTED" value="false"/>
        <env name="CASHFREE_CLIENT_SECRET" value="test-client-secret"/>
        <env name="CASHFREE_VERIFY_SIGNATURE" value="false"/>
        <!-- Deterministic Cashfree automation actor; force so local .env cannot leak. -->
        <env name="CASHFREE_SYSTEM_USER_EMAIL" value="superadmin@radium.local" force="true"/>
        <env name="RDSERVICE_ENABLED" value="false" force="true"/>
        <env name="DESK_ORDER_API_TOKEN" value="" force="true"/>
        <env name="RDSERVICE_BASE_URL" value="https://rdservice.net" force="true"/>
        <env name="RADIUMBOX_ADMIN_FALLBACK_ENABLED" value="false" force="true"/>
        <env name="RDSERVICE_IN_LOOKUP_ENABLED" value="false" force="true"/>
        <env name="RADIUMBOX_STOREFRONT_LOOKUP_ENABLED" value="false" force="true"/>
        <env name="CHANNEL_INGEST_SECRET_RDSERVICE_IN" value="" force="true"/>
        <env name="CHANNEL_INGEST_SECRET_RDSERVICE_NET" value="" force="true"/>
        <env name="CHANNEL_INGEST_SECRET_RADIUMBOX_COM" value="" force="true"/>
        <env name="CHANNEL_INGEST_SECRET_RADIUMSIGN_COM" value="" force="true"/>
        <env name="CHANNEL_INGEST_SECRET_FUTURE" value="" force="true"/>
        <env name="CHANNEL_INGEST_CUTOVER_APPROVED" value="false" force="true"/>
        <env name="STATUTORY_EINVOICE_PROVIDER" value="none" force="true"/>
        <env name="STATUTORY_INVOICE_SERIES_CODE" value="" force="true"/>
        <env name="STATUTORY_INVOICE_NUMBER_FORMAT" value="" force="true"/>
        <env name="STATUTORY_INVOICE_GSTIN_SCOPE" value="" force="true"/>
        <env name="STATUTORY_INVOICE_LEGAL_NAME" value="" force="true"/>
        <env name="STATUTORY_INVOICE_SCOPE_STARTS_AT" value="2026-09-01 00:00:00" force="true"/>
    </php>
</phpunit>
